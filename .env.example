# AWS region for DynamoDB. Required when connecting to real AWS.
AWS_REGION=us-east-1

# For local development with DynamoDB Local (docker compose up).
# DynamoDB Local accepts any non-empty string for credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Override the DynamoDB endpoint for local development.
# Unset this variable (or remove it) when connecting to real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# The DynamoDB table name. Defaults to "ripples" if not set.
DYNAMODB_TABLE_NAME=ripples

# ─── Organization ────────────────────────────────────────────────────────────
# Display name of your organization. Required — the API will not start without it.
ORG_NAME=Acme Engineering

# IANA timezone identifier for the organization. Defaults to UTC.
ORG_TIMEZONE=UTC

# ─── Authentication (AWS Cognito) ────────────────────────────────────────────
# Your Cognito User Pool ID (e.g. us-east-1_AbCdEfGhI). Required.
COGNITO_USER_POOL_ID=us-east-1_CHANGE_ME

# The Cognito App Client ID associated with this deployment. Required.
COGNITO_CLIENT_ID=CHANGE_ME
